# FrankenPHP ships the PHP runtime together with a production Caddy web server,
# which is what Vercel's container runtime expects to find on $PORT.
FROM dunglas/frankenphp:1-php8.5.11-bookworm AS base

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions intl opcache

WORKDIR /app

# Dependencies are installed in their own stage so the layer is cached until
# composer.json / composer.lock actually change. Scripts are skipped here on
# purpose; they run after the application source is copied in.
FROM base AS dependencies

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --optimize-autoloader \
    --prefer-dist

FROM base AS runtime

COPY --chown=www-data:www-data . /app
COPY --from=dependencies --chown=www-data:www-data /app/vendor /app/vendor
COPY --chown=www-data:www-data Caddyfile /etc/frankenphp/Caddyfile

RUN setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /app /config/caddy /data/caddy

ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false

USER www-data

EXPOSE 80

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]